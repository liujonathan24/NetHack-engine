.venv/
.pytest_cache/
__pycache__/
*.pyc
.uv_cache/
dist/
*.egg-info/
.DS_Store

# dashboard local cache
tools/.dashboard_cache/

# agent worktrees
.claude/worktrees/

# node / npm tooling (not part of the Python project)
node_modules/
package.json
package-lock.json
skills-lock.json

# local agent tooling installs (comet / openspec skills + commands)
.claude/skills/
.claude/commands/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# Vendored engine copy: a build artifact regenerated by tools/bundle_for_hub.py
# for `prime env push`. The source of truth is the workspace-root nethack_core/.
# Do not commit it; run `python tools/bundle_for_hub.py` before pushing.
environments/nethack/nethack_core/

# nle low-level ttyrec side-effect files
*.ttyrec*.bz2

# engine crash artifacts (core dumps + sentinel crash logs)
core.*
nle_crash_*.txt

# web play recordings (generated)
/outputs/web_play/

# Internal process / workflow artifacts — these live on the `experimental`
# branch, not on main. Kept out of the clean public tree but preserved on
# disk locally and on GitHub (origin/experimental). See docs/REPO_MAP.md.
/experiments/
/openspec/
/tools/launchpad/
/docs/superpowers/
/docs/onboarding/
/docs/MONDAY_TALKING_POINTS.md
/SESSION_SUMMARY.md
/WAKE_UP.md
/experiment_log.md
/claude_haiku.log
/current_eval.log
/tools/run_demo.py
/tools/record_versioned_demo.py
/tools/compare_evals.py

# Encoding-eval run artifacts: bulky per-turn traces / logs / vf-eval eval dirs.
# Keep the small aggregated tables (table.md / table.json) tracked.
/outputs/encoding_eval/**/trace/
/outputs/encoding_eval/**/evals/
/outputs/encoding_eval/**/*.log
/outputs/encoding_eval/*.log
